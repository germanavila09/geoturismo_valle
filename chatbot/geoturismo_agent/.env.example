# Modelo Gemini (Google AI Studio)
# Obtén tu API key en: https://aistudio.google.com/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=AIzaSy...tu_key_aqui

# Modelo a usar (cuotas gratuitas en 2025):
#   gemini-2.5-flash-lite : 1.000 RPD, 15 RPM  ← recomendado
#   gemini-2.5-flash      :    20 RPD,  5 RPM
#   gemini-2.5-pro        :    50 RPD,  5 RPM
GEMINI_MODEL=gemini-2.5-flash-lite

# Puerto del servidor FastAPI (default 8081, para no chocar con geosalud en 8080)
CHATBOT_PORT=8081
